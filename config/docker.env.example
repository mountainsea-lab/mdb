# Financial Data Center Docker deployment profile.
# Used by docker-compose.yml. Copy to config/docker.env for private overrides if needed.

FDC_SERVER_ADDR=0.0.0.0:18080
FDC_SERVER_ENV=production

# Safe default: live acquisition is available but does not autostart.
FDC_LIVE_ENABLED=1
FDC_LIVE_AUTOSTART=0
FDC_LIVE_DEFAULT_TIMEOUT_SECS=30
FDC_LIVE_DEFAULT_MAX_ENVELOPES=100
FDC_LIVE_RETRY_ENABLED=1
FDC_LIVE_RETRY_INITIAL_DELAY_MS=1000
FDC_LIVE_RETRY_MAX_DELAY_MS=30000
FDC_LIVE_MAX_CONSECUTIVE_FAILURES=3
FDC_MARKET_DATA_LIVE_RESUME_ENABLED=0

# Persist tiered market-data storage on the mounted /app/var/fdc-market-data volume.
FDC_MARKET_DATA_STORAGE_BACKEND=tiered
FDC_MARKET_DATA_STORAGE_POLICY_PROFILE=generic_realtime
FDC_MARKET_DATA_STORAGE_L2_REDB_PATH=./var/fdc-market-data/l2.redb
FDC_MARKET_DATA_STORAGE_L3_DUCKDB_PATH=./var/fdc-market-data/l3.duckdb
FDC_MARKET_DATA_STORAGE_L4_ROCKSDB_PATH=./var/fdc-market-data/l4-rocksdb

# Manual storage maintenance is enabled; background scheduler is disabled by default.
FDC_MARKET_DATA_STORAGE_MAINTENANCE_ENABLED=1
FDC_MARKET_DATA_STORAGE_MAINTENANCE_AUDIT_CAPACITY=64
FDC_MARKET_DATA_STORAGE_MAINTENANCE_AUDIT_RESET_ENABLED=0
FDC_MARKET_DATA_STORAGE_MAINTENANCE_SCHEDULER_ENABLED=0
FDC_MARKET_DATA_STORAGE_MAINTENANCE_SCHEDULER_RESET_ENABLED=0
FDC_MARKET_DATA_STORAGE_MAINTENANCE_SCHEDULER_RESUME_ENABLED=0
FDC_MARKET_DATA_STORAGE_MAINTENANCE_SCHEDULER_INTERVAL_SECONDS=3600
FDC_MARKET_DATA_STORAGE_MAINTENANCE_SCHEDULER_TIMEOUT_MS=30000
FDC_MARKET_DATA_STORAGE_MAINTENANCE_SCHEDULER_JITTER_SECONDS=0
FDC_MARKET_DATA_STORAGE_MAINTENANCE_SCHEDULER_MAX_CONSECUTIVE_FAILURES=3

# Safe default: Binance Futures USD perpetual candle/OHLCV acquisition is available but disabled.
# To run long-term automatic candle maintenance, set enabled=1, scheduler_enabled=1,
# and provide symbols/intervals/bounds from the production runbook.
FDC_MARKET_DATA_CONTRACTS_ENABLED=0
FDC_MARKET_DATA_CONTRACTS_AUTOSTART=0
FDC_MARKET_DATA_CONTRACTS_EXCHANGE=binance_futures_usd
FDC_MARKET_DATA_CONTRACTS_SYMBOLS=
FDC_MARKET_DATA_CONTRACTS_KINDS=candle
FDC_MARKET_DATA_CONTRACTS_INTERVALS=
FDC_MARKET_DATA_CONTRACTS_LIMIT_PER_PAGE=1000
FDC_MARKET_DATA_CONTRACTS_MAX_PAGES_PER_RUN=1
FDC_MARKET_DATA_CONTRACTS_SCHEDULER_ENABLED=0
FDC_MARKET_DATA_CONTRACTS_SCHEDULER_INTERVAL_SECONDS=3600
FDC_MARKET_DATA_CONTRACTS_SCHEDULER_JITTER_SECONDS=0
FDC_MARKET_DATA_CONTRACTS_SCHEDULER_MAX_CONSECUTIVE_FAILURES=3
